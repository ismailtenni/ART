{
  "name": "artist",
  "main": "ARTSITE/_worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./ARTSITE/public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ismailtenni-art-site"
    }
  ],
  "vars": {
    "ADMIN_EMAIL": "ismailtenni6@gmail.com"
  }
}
