{
  "name": "art-ismailtenni",
  "productName": "ART-ISMAILTENNI",
  "version": "1.0.0",
  "description": "ART-ISMAILTENNI - art and fantasy world by Ismail Tenni",
  "author": "ISMAILTENNI ART",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ismailtenni.art",
    "productName": "ART-ISMAILTENNI",
    "directories": { "output": "dist" },
    "files": ["main.js", "icon.png"],
    "win": {
      "icon": "icon.ico",
      "target": ["portable", "nsis"]
    },
    "portable": { "artifactName": "ART-ISMAILTENNI.exe" },
    "nsis": {
      "artifactName": "ART-ISMAILTENNI-Setup.exe",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ART-ISMAILTENNI"
    }
  }
}
